# ─────────────────────────────────────────────────────────────
# Spectre V2 environment variables
# Copy this file to .env.local and fill in the keys you want.
# All keys are optional; layers without their key simply stay off.
# ─────────────────────────────────────────────────────────────

# Cesium Ion (terrain, OSM 3D Buildings)
# https://ion.cesium.com/tokens
NEXT_PUBLIC_CESIUM_TOKEN=

# Google Maps (Photorealistic 3D Tiles, Street View snapshots for CCTV)
# https://console.cloud.google.com/google/maps-apis
NEXT_PUBLIC_GOOGLE_API_KEY=
GOOGLE_MAPS_API_KEY=

# OpenSky (commercial + private flights, OAuth2)
# https://openskynetwork.org/my-account
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# RapidAPI (flight track enrichment)
RAPIDAPI_KEY=

# TomTom (traffic flow tiles)
# https://developer.tomtom.com
TOMTOM_API_KEY=
TOMTOM_DAILY_TILE_BUDGET=2000

# ACLED (armed conflict event data for civil unrest)
# https://developer.acleddata.com
ACLED_EMAIL=
ACLED_KEY=

# NASA FIRMS (active fire detection)
# https://firms.modaps.eosdis.nasa.gov/api/map_key
FIRMS_MAP_KEY=

# CCTV sources
SHODAN_API_KEY=
WINDY_API_KEY=
NY511_API_KEY=
LTA_API_KEY=
TFNSW_API_KEY=
