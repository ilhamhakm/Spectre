# Spectre environment variables
# Copy this file to .env.local for local development.
# All variables are OPTIONAL — the app degrades gracefully when keys are missing
# (kevtoe pattern, see planning/03_repo_infrastructure.md §6).

# --- Cesium (free, optional for v0) ---
# Cesium Ion access token. When empty/unset, the globe falls back to OSM
# imagery, which is acceptable for v0 per planning/05_architecture.md §2.1.
NEXT_PUBLIC_CESIUM_ION_TOKEN=

# --- OpenSky (free, OAuth2 credentials) ---
# Optional but recommended. Without OAuth2, the API IP-bans after ~1.7h of
# sustained polling (planning/05_architecture.md Appendix A D6).
OPENSKY_USERNAME=
OPENSKY_PASSWORD=

# --- ACLED (free for non-commercial use) ---
# Registration-only account. Weekly cron pulls CAMEO 14*/15* events.
ACLED_EMAIL=
ACLED_KEY=

# --- NASA FIRMS (free, optional) ---
# Fire/thermal anomaly satellite detection (VIIRS). Register at
# https://firms.modaps.eosdis.nasa.gov/api/area/ to get a MAP_KEY. When
# unset, the source is skipped silently — no errors.
FIRMS_MAP_KEY=

# --- Shodan (free tier, 100 query credits/month) ---
# Used for CCTV camera discovery with screenshots. Returns base64-encoded
# snapshots of publicly accessible IP cameras in Indonesia. Register at
# https://www.shodan.io/ to get a free API key.
SHODAN_API_KEY=

# --- Windy Webcams API (free, primary CCTV source) ---
# Used for public webcam snapshots with lat/lon. Returns direct JPEG URLs
# that work internationally (no geo-blocking). Free tier: 10-min image token
# TTL, small image sizes only. Register at https://api.windy.com/keys
WINDY_API_KEY=

# --- Gemini (Google AI — deferred to v1.5) ---
# Used for video analysis pipeline in Phase 1.5+. Not needed for v0/v1.
GEMINI_API_KEY=

# --- Supabase (deferred to Phase 1) ---
# Postgres + Realtime. v0 uses in-memory cache only.
SUPABASE_URL=
SUPABASE_ANON_KEY=
